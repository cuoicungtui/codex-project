# Copy this file to `.env` and fill in real values locally.

# OpenAI-compatible small model runtime
SMALL_LLM_PROVIDER=openai_compatible
SMALL_LLM_MODEL=your-model-id
SMALL_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
SMALL_LLM_API_KEY=your-api-key

# Optional runtime tuning
SMALL_LLM_TEMPERATURE=0.2
SMALL_LLM_MAX_TOKENS=4096
SMALL_LLM_TIMEOUT_SECONDS=120
# Optional for reasoning/omni models routed through OpenAI-compatible providers.
# Common values depend on provider/model, for example: none, min, low, medium, high.
SMALL_LLM_REASONING_EFFORT=

# Local workspace configuration
SKILL_RUNTIME_WORKSPACE_ROOT=.
SKILL_RUNTIME_TRACE_LEVEL=standard
